  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
    }
    body {
      background: #f8fafc;
      padding: 20px;
      display: flex;
      justify-content: center;
      color: #0b1e33;
    }
    .container {
      max-width: 1200px;
