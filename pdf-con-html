<body>
<div class="container">
  <!-- Header -->
  <header>
    <h1><i class="fas fa-file-pdf"></i> PDF Converter & Editor</h1>
    <div class="sub"><i class="fas fa-arrows-spin"></i> Image / Word → PDF · Quality control · Edit & optimize</div>
  </header>

  <!-- Main flex: content + ad -->
  <div class="flex-row">
    <!-- Left main -->
    <div class="main-area">
      <!-- Upload -->
      <div class="upload-zone" id="uploadZone">
        <i class="fas fa-cloud-upload-alt"></i>
        <p>Drop files or click to upload</p>
        <small>Supports JPG, PNG, WEBP, DOCX</small>
        <input type="file" id="fileInput" accept=".jpg,.jpeg,.png,.webp,.docx" multiple>
      </div>

      <!-- Preview files -->
      <div id="previewContainer" class="preview-grid"></div>

      <!-- Quality control -->
      <div class="quality-section">
        <label><i class="fas fa-sliders-h"></i> Quality</label>
        <input type="range" id="qualitySlider" min="10" max="100" value="85">
        <span class="q-value" id="qualityDisplay">85%</span>
        <span style="color:#475569; font-size:0.85rem;"><i class="fas fa-info-circle"></i> Lower = smaller file</span>
      </div>

      <!-- Action buttons -->
      <div class="btn-group">
        <button class="btn btn-primary" id="convertBtn"><i class="fas fa-file-export"></i> Convert to PDF</button>
        <button class="btn btn-success" id="optimizeBtn"><i class="fas fa-compress-arrows-alt"></i> Optimize & Download</button>
        <button class="btn btn-outline" id="clearBtn"><i class="fas fa-trash-alt"></i> Clear</button>
      </div>

      <!-- Status -->
      <div class="status-area" id="statusArea">
        <i class="fas fa-circle-info"></i> <span id="statusMessage">Ready. Upload images or a Word file.</span>
      </div>

      <!-- Hidden download -->
      <div id="downloadLink">
        <a id="downloadAnchor" class="btn btn-success" download="converted.pdf"><i class="fas fa-download"></i> Download PDF</a>
      </div>
    </div>

    <!-- Right ad column -->
    <div class="ad-side">
      <div class="ad-box">
        <i class="fas fa-ad"></i>
        <span class="ad-label">Advertisement</span>
        <!-- AdSense unit placeholder — replace data-ad-slot with your ID -->
        <div class="adsense-unit" id="adsensePlaceholder">
          <span><i class="fas fa-code"></i> Ad unit: ca-pub-xxxxxx</span>
        </div>
        <p style="font-size:0.7rem; color:#64748b; margin-top:6px;">Your AdSense unit ID here</p>
        <!-- Actual AdSense code can be inserted below. Using a placeholder for demo -->
        <div style="width:100%; min-height:60px; background:#e2e8f0; border-radius:12px; display:flex; justify-content:center; align-items:center; color:#475569; font-size:0.7rem; border:1px dashed #94a3b8; margin-top:8px;">
          <i class="fas fa-google"></i> Google AdSense (auto)
        </div>
      </div>
    </div>
  </div>

  <!-- Footer SEO -->
  <footer>
    <span>© 2026 PDF Tools — <i class="fas fa-robot"></i> SEO optimized</span>
    <span><i class="fas fa-shield-alt"></i> Secure · 100% client-side</span>
  </footer>
</div>

<script>
  (function() {
    // DOM refs
    const fileInput = document.getElementById('fileInput');
    const uploadZone = document.getElementById('uploadZone');
    const previewContainer = document.getElementById('previewContainer');
    const qualitySlider = document.getElementById('qualitySlider');
    const qualityDisplay = document.getElementById('qualityDisplay');
    const statusMsg = document.getElementById('statusMessage');
    const convertBtn = document.getElementById('convertBtn');
    const optimizeBtn = document.getElementById('optimizeBtn');
    const clearBtn = document.getElementById('clearBtn');
    const downloadLink = document.getElementById('downloadLink');
    const downloadAnchor = document.getElementById('downloadAnchor');

    // State: store files and processed data
    let fileList = [];          // raw File objects
    let processedImages = [];   // { name, dataURL, type }
    let docxContent = null;     // { html, name } for word content

    // Quality
    let currentQuality = 85;

    // Update quality display
    qualitySlider.addEventListener('input', function() {
      currentQuality = parseInt(this.value, 10);
      qualityDisplay.textContent = currentQuality + '%';
    });

    // Click upload zone
    uploadZone.addEventListener('click', () => fileInput.click());
    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.style.borderColor = '#2563eb'; });
    uploadZone.addEventListener('dragleave', () => { uploadZone.style.borderColor = '#cbd5e1'; });
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.style.borderColor = '#cbd5e1';
      if (e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length) handleFiles(e.target.files);
      fileInput.value = ''; // reset
    });

    // Handle files
    function handleFiles(files) {
      const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
      let hasValid = false;
      for (let f of files) {
        if (validTypes.includes(f.type)) {
          fileList.push(f);
          hasValid = true;
        } else {
          statusMsg.textContent = `⚠️ Skipped unsupported file: ${f.name}`;
        }
      }
      if (!hasValid) {
        if (files.length) statusMsg.textContent = '⚠️ No supported files. Use JPG, PNG, WEBP, DOCX.';
        return;
      }
      statusMsg.textContent = `📄 ${fileList.length} file(s) loaded. Processing...`;
      processFiles();
    }

    // Process files: images -> dataURL, docx -> html
    function processFiles() {
      processedImages = [];
      docxContent = null;
      let pending = fileList.length;
      if (pending === 0) { updatePreview(); return; }

      fileList.forEach((file, index) => {
        if (file.type.startsWith('image/')) {
          const reader = new FileReader();
          reader.onload = (e) => {
            processedImages.push({
              name: file.name,
              dataURL: e.target.result,
              type: file.type
            });
            pending--;
            if (pending === 0) updatePreview();
          };
          reader.readAsDataURL(file);
        } else if (file.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') {
          // Word docx
          const reader = new FileReader();
          reader.onload = (e) => {
            const arrayBuffer = e.target.result;
            mammoth.convertToHtml({ arrayBuffer: arrayBuffer })
              .then(result => {
                docxContent = { html: result.value, name: file.name };
                pending--;
                if (pending === 0) updatePreview();
              })
              .catch(err => {
                statusMsg.textContent = '⚠️ Error reading DOCX: ' + err.message;
                pending--;
                if (pending === 0) updatePreview();
              });
          };
          reader.readAsArrayBuffer(file);
        } else {
          pending--;
          if (pending === 0) updatePreview();
        }
      });
    }

    // Render previews
    function updatePreview() {
      previewContainer.innerHTML = '';
      let totalItems = processedImages.length + (docxContent ? 1 : 0);
      if (totalItems === 0) {
        previewContainer.innerHTML = '<div style="padding:10px; color:#64748b;">No preview available</div>';
        statusMsg.textContent = '📂 Upload images or a Word file.';
        return;
      }

      // Images
      processedImages.forEach(img => {
        const div = document.createElement('div');
        div.className = 'preview-item';
        div.innerHTML = `<img src="${img.dataURL}" alt="${img.name}"><div class="file-name">${img.name}</div>`;
        previewContainer.appendChild(div);
      });

      // Word doc preview
      if (docxContent) {
        const div = document.createElement('div');
        div.className = 'preview-item';
        div.style.width = '140px';
        div.innerHTML = `<i class="fas fa-file-word" style="font-size:3rem; color:#2b5797;"></i><div class="file-name">${docxContent.name}</div>`;
        previewContainer.appendChild(div);
      }

      statusMsg.textContent = `✅ ${totalItems} file(s) ready. Quality: ${currentQuality}%`;
    }

    // ----- CONVERT to PDF (using jsPDF + html2canvas for images, and mammoth for word) -----
    async function convertToPDF(optimize = false) {
      if (processedImages.length === 0 && !docxContent) {
        statusMsg.textContent = '⚠️ No images or Word document to convert.';
        return;
      }

      statusMsg.textContent = '⏳ Generating PDF...';
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF('p', 'mm', 'a4');
      const pageWidth = 210;
      const pageHeight = 297;
      const margin = 12;
      const maxWidth = pageWidth - 2 * margin;
      let y = margin;

      // helper: add image to pdf
      function addImageToPDF(imgData, name) {
        return new Promise((resolve) => {
          const img = new Image();
          img.onload = function() {
            let imgWidth = img.width;
            let imgHeight = img.height;
            const ratio = imgWidth / imgHeight;
            let displayWidth = maxWidth;
            let displayHeight = displayWidth / ratio;
            if (displayHeight > pageHeight - margin * 2) {
              displayHeight = pageHeight - margin * 2;
              displayWidth = displayHeight * ratio;
            }
            // if y + displayHeight > pageHeight, add page
            if (y + displayHeight > pageHeight - margin) {
              doc.addPage();
              y = margin;
            }
            // quality: use slider
            const qualityFactor = currentQuality / 100;
            // compress using canvas
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = img.width * qualityFactor;
            canvas.height = img.height * qualityFactor;
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
            const dataUrl = canvas.toDataURL('image/jpeg', qualityFactor);
            doc.addImage(dataUrl, 'JPEG', margin, y, displayWidth, displayHeight);
            y += displayHeight + 6;
            resolve();
          };
          img.onerror = () => { resolve(); };
          img.src = imgData;
        });
      }

      // Process images
      for (let i = 0; i < processedImages.length; i++) {
        await addImageToPDF(processedImages[i].dataURL, processedImages[i].name);
      }

      // Process Word content (if any)
      if (docxContent) {
        // render HTML as canvas then image
        const wrapper = document.createElement('div');
        wrapper.style.width = '500px';
        wrapper.style.padding = '16px';
        wrapper.style.background = 'white';
        wrapper.style.fontFamily = 'Arial, sans-serif';
        wrapper.style.fontSize = '14px';
        wrapper.style.lineHeight = '1.5';
        wrapper.style.color = '#0b1e33';
        wrapper.innerHTML = docxContent.html;
        document.body.appendChild(wrapper);

        try {
          const canvas = await html2canvas(wrapper, {
            scale: 1.2,
            useCORS: true,
            backgroundColor: '#ffffff',
            logging: false,
          });
          const dataUrl = canvas.toDataURL('image/jpeg', currentQuality/100);
          document.body.removeChild(wrapper);
          await addImageToPDF(dataUrl, 'word_content');
        } catch(e) {
          document.body.removeChild(wrapper);
          statusMsg.textContent = '⚠️ Word conversion error: ' + e.message;
        }
      }

      // Finalize
      const pdfOutput = doc.output('blob');
      const url = URL.createObjectURL(pdfOutput);
      downloadAnchor.href = url;
      downloadLink.style.display = 'block';
      statusMsg.textContent = '✅ PDF generated successfully! Click download.';
    }

    // Events
    convertBtn.addEventListener('click', () => convertToPDF(false));
    optimizeBtn.addEventListener('click', () => {
      // Optimization: just uses quality, same as convert but we notify
      convertToPDF(true);
    });

    clearBtn.addEventListener('click', function() {
      fileList = [];
      processedImages = [];
      docxContent = null;
      previewContainer.innerHTML = '<div style="padding:10px; color:#64748b;">No files</div>';
      downloadLink.style.display = 'none';
      statusMsg.textContent = '🗑️ Cleared. Upload new files.';
    });

    // Initial state
    statusMsg.textContent = '📂 Upload images or a Word document.';
  })();
</script>

<!-- AdSense insertion point: you can replace the placeholder with your AdSense code -->
<!-- In a real scenario, paste the AdSense unit code inside the adsense-unit div -->
</body>
