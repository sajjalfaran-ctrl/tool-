  <!-- SEO Meta -->
  <meta name="description" content="Compress images online for free. Select resolution and quality, reduce file size up to 80% with preview. SEO optimized tool.">
  <link rel="canonical" href="https://yourdomain.com/image-compressor">
  <meta name="google-adsense-account" content="ca-pub-xxxxxxxxxxxxx">
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    body {
      background: #f4f8fc;
      padding: 24px 20px;
      display: flex;
      justify-content: center;
      color: #0b1e33;
    }
    .container {
      max-width: 1240px;
      width: 100%;
      background: white;
      border-radius: 40px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.04);
      padding: 28px 30px 20px;
    }
    /* header */
    .header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    .logo {
      font-size: 1.8rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .logo i {
      color: #2563eb;
    }
    .subhead {
      color: #475569;
      font-size: 1rem;
      background: #f1f5f9;
      padding: 6px 20px;
      border-radius: 40px;
    }
    /* ad row */
    .ad-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin: 12px 0 24px;
      background: #f8fafc;
      border-radius: 28px;
      padding: 12px 16px;
      border: 1px dashed #cbd5e1;
      align-items: center;
      justify-content: center;
    }
    .ad-slot {
      background: #eef2f6;
      border-radius: 20px;
      padding: 12px 20px;
      min-height: 80px;
      min-width: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: #334155;
      font-weight: 500;
      flex: 1 1 200px;
    }
    .ad-slot i {
      font-size: 1.8rem;
      color: #475569;
    }
    /* main 2-col */
    .flex-main {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      margin: 16px 0 10px;
    }
    .left-panel {
      flex: 2;
      min-width: 300px;
    }
    .right-panel {
      flex: 1;
      min-width: 200px;
      background: #f8fafc;
      border-radius: 32px;
      padding: 18px 16px;
      border: 1px solid #e9edf2;
    }
    /* upload zone */
    .upload-zone {
      background: #f8fafc;
      border: 2px dashed #cbd5e1;
      border-radius: 32px;
      padding: 36px 20px;
      text-align: center;
      cursor: pointer;
      transition: 0.2s;
      margin-bottom: 18px;
    }
    .upload-zone:hover {
      border-color: #2563eb;
      background: #f1f5f9;
    }
    .upload-zone i {
      font-size: 3.6rem;
      color: #2563eb;
    }
    .upload-zone p {
      font-weight: 500;
      margin: 6px 0 2px;
    }
    .upload-zone small {
      color: #64748b;
    }
    #fileInput {
      display: none;
    }
    /* preview area */
    .preview-box {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin: 14px 0 18px;
      align-items: center;
    }
    .preview-img {
      max-width: 100%;
      max-height: 220px;
      border-radius: 24px;
      background: #f1f5f9;
      padding: 4px;
      border: 1px solid #e2e8f0;
      object-fit: contain;
    }
    .info-badge {
      background: #eaf3ff;
      padding: 6px 18px;
      border-radius: 40px;
      font-size: 0.9rem;
      font-weight: 500;
    }
    /* resolution & quality */
    .control-group {
      background: #f1f5f9;
      border-radius: 40px;
      padding: 14px 22px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 30px;
      margin: 12px 0;
    }
    .control-group label {
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .control-group input[type="range"] {
      width: 160px;
      accent-color: #2563eb;
    }
    .control-group .value-badge {
      background: #2563eb;
      color: white;
      padding: 2px 16px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.9rem;
    }
    .resolution-select {
      padding: 6px 14px;
      border-radius: 40px;
      border: 1px solid #cbd5e1;
      background: white;
      font-weight: 500;
    }
    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 16px 0 10px;
    }
    .btn {
      border: none;
      padding: 12px 28px;
      border-radius: 60px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      transition: 0.15s;
      font-size: 0.95rem;
      background: #e9edf2;
      color: #1e293b;
    }
    .btn-primary {
      background: #2563eb;
      color: white;
    }
    .btn-primary:hover { background: #1d4ed8; }
    .btn-success {
      background: #0b8a4b;
      color: white;
    }
    .btn-success:hover { background: #0a7a42; }
    .btn-outline {
      background: transparent;
      border: 1.5px solid #94a3b8;
    }
    .btn i { font-size: 1.1rem; }
    .status-area {
      background: #f1f5f9;
      border-radius: 40px;
      padding: 12px 20px;
      margin: 14px 0 6px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .status-area i { color: #2563eb; }
    #downloadLink {
      display: none;
      margin-top: 10px;
    }
    /* right panel ads */
    .right-ad-box {
      background: #f1f5f9;
      border-radius: 24px;
      padding: 16px 10px;
      text-align: center;
      border: 1px dashed #94a3b8;
      margin-bottom: 14px;
    }
    .right-ad-box .ad-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      color: #64748b;
      letter-spacing: 0.4px;
    }
    .adsense-unit {
      background: #e2e8f0;
      border-radius: 16px;
      min-height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #334155;
      font-weight: 500;
      gap: 8px;
      padding: 10px;
      margin: 8px 0;
      border: 1px solid #d1d9e6;
    }
    .footer {
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      font-size: 0.85rem;
      color: #475569;
    }
    @media (max-width: 700px) {
      .container { padding: 18px 14px; }
      .header { flex-direction: column; align-items: start; gap: 6px; }
      .control-group input[type="range"] { width: 120px; }
      .right-panel { min-width: 100%; }
    }
    @media (max-width: 480px) {
      .control-group { flex-direction: column; align-items: stretch; }
    }
  </style>
</head>
<body>
<div class="container">
  <!-- header -->
  <div class="header">
    <div class="logo"><i class="fas fa-compress-arrows-alt"></i> Image<span style="color:#2563eb;">Compressor</span></div>
    <span class="subhead"><i class="fas fa-sliders-h"></i> Quality & resolution control</span>
  </div>

  <!-- Ad row (top) -->
  <div class="ad-row">
    <div class="ad-slot"><i class="fas fa-ad"></i> Ad Unit · ca-pub-xxxxxx</div>
    <div class="ad-slot"><i class="fas fa-google"></i> Google AdSense placeholder</div>
  </div>

  <!-- main flex -->
  <div class="flex-main">
    <!-- left panel -->
    <div class="left-panel">
      <!-- upload -->
      <div class="upload-zone" id="uploadZone">
        <i class="fas fa-cloud-upload-alt"></i>
        <p>Drop image or click to upload</p>
        <small>JPG, PNG, WEBP · Max 20MB</small>
        <input type="file" id="fileInput" accept=".jpg,.jpeg,.png,.webp" multiple>
      </div>

      <!-- preview & info -->
      <div id="previewContainer" class="preview-box">
        <span style="color:#94a3b8;"><i class="fas fa-image"></i> No image loaded</span>
      </div>

      <!-- resolution + quality -->
      <div class="control-group">
        <label><i class="fas fa-arrows-alt"></i> Resolution</label>
        <select id="resolutionSelect" class="resolution-select">
          <option value="original">Original</option>
          <option value="1920">1920px (HD)</option>
          <option value="1280">1280px (HD ready)</option>
          <option value="800">800px (web)</option>
          <option value="500">500px (thumb)</option>
        </select>

        <label><i class="fas fa-sliders-h"></i> Quality</label>
        <input type="range" id="qualitySlider" min="10" max="100" value="85">
        <span class="value-badge" id="qualityDisplay">85%</span>
      </div>

      <!-- actions -->
      <div class="btn-group">
        <button class="btn btn-primary" id="compressBtn"><i class="fas fa-compress-alt"></i> Compress</button>
        <button class="btn btn-success" id="downloadBtn"><i class="fas fa-download"></i> Download</button>
        <button class="btn btn-outline" id="clearBtn"><i class="fas fa-trash-alt"></i> Clear</button>
      </div>

      <!-- status -->
      <div class="status-area" id="statusArea">
        <i class="fas fa-circle-info"></i> <span id="statusMessage">Upload an image to start.</span>
      </div>

      <div id="downloadLink">
        <a id="downloadAnchor" class="btn btn-success" download="compressed.jpg"><i class="fas fa-download"></i> Save compressed</a>
      </div>
    </div>

    <!-- right panel ad -->
    <div class="right-panel">
      <div class="right-ad-box">
        <div class="ad-label"><i class="fas fa-ad"></i> Advertisement</div>
        <div class="adsense-unit" id="adsensePlaceholder">
          <i class="fas fa-code"></i> Ad unit: ca-pub-xxxxxx
        </div>
        <p style="font-size:0.7rem; color:#64748b; margin-top:6px;">Replace with your AdSense code</p>
        <div style="width:100%; min-height:70px; background:#e2e8f0; border-radius:16px; display:flex; justify-content:center; align-items:center; color:#475569; font-size:0.7rem; border:1px dashed #94a3b8; margin-top:10px;">
          <i class="fas fa-google"></i> AdSense auto
        </div>
      </div>
      <div style="background:#f1f5f9; border-radius:24px; padding:12px; text-align:center; border:1px solid #e2e8f0; margin-top:10px;">
        <i class="fas fa-info-circle" style="color:#2563eb;"></i> <span style="font-weight:500;">Compression stats</span>
        <div id="statsDisplay" style="font-size:0.9rem; color:#475569; margin-top:4px;">Original: — · Compressed: —</div>
      </div>
    </div>
  </div>

  <!-- footer -->
  <div class="footer">
    <span><i class="fas fa-shield-alt"></i> 100% client-side · private</span>
    <span>© 2026 ImageCompressor — <i class="fas fa-robot"></i> SEO optimized</span>
  </div>
</div>

<script>
  (function(){
    // DOM refs
    const fileInput = document.getElementById('fileInput');
    const uploadZone = document.getElementById('uploadZone');
    const previewContainer = document.getElementById('previewContainer');
    const qualitySlider = document.getElementById('qualitySlider');
    const qualityDisplay = document.getElementById('qualityDisplay');
    const resolutionSelect = document.getElementById('resolutionSelect');
    const statusMsg = document.getElementById('statusMessage');
    const compressBtn = document.getElementById('compressBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const clearBtn = document.getElementById('clearBtn');
    const downloadLink = document.getElementById('downloadLink');
    const downloadAnchor = document.getElementById('downloadAnchor');
    const statsDisplay = document.getElementById('statsDisplay');

    // state
    let originalFile = null;          // File object
    let originalDataURL = null;       // for preview
    let compressedDataURL = null;     // result
    let originalSize = 0;
    let compressedSize = 0;
    let currentQuality = 85;
    let currentResolution = 'original';

    // quality slider
    qualitySlider.addEventListener('input', function() {
      currentQuality = parseInt(this.value, 10);
      qualityDisplay.textContent = currentQuality + '%';
    });

    resolutionSelect.addEventListener('change', function() {
      currentResolution = this.value;
    });

    // upload
    uploadZone.addEventListener('click', () => fileInput.click());
    uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.style.borderColor = '#2563eb'; });
    uploadZone.addEventListener('dragleave', () => { uploadZone.style.borderColor = '#cbd5e1'; });
    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.style.borderColor = '#cbd5e1';
      if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length) handleFile(e.target.files[0]);
      fileInput.value = '';
    });

    function handleFile(file) {
      if (!file.type.startsWith('image/')) {
        statusMsg.textContent = '⚠️ Please select an image file (JPG, PNG, WEBP).';
        return;
      }
      if (file.size > 20 * 1024 * 1024) {
        statusMsg.textContent = '⚠️ File too large (max 20MB).';
        return;
      }
      originalFile = file;
      originalSize = file.size;
      const reader = new FileReader();
      reader.onload = (e) => {
        originalDataURL = e.target.result;
        showPreview(originalDataURL);
        statusMsg.textContent = `📄 Loaded: ${file.name} (${(originalSize/1024).toFixed(1)} KB)`;
        compressedDataURL = null;
        downloadLink.style.display = 'none';
        statsDisplay.textContent = 'Original: ' + (originalSize/1024).toFixed(1) + ' KB · Compressed: —';
      };
      reader.readAsDataURL(file);
    }

    function showPreview(dataURL) {
      previewContainer.innerHTML = `<img src="${dataURL}" class="preview-img" alt="preview">`;
    }

    // compress function
    function compressImage() {
      if (!originalDataURL) {
        statusMsg.textContent = '⚠️ No image loaded. Upload first.';
        return;
      }

      statusMsg.textContent = '⏳ Compressing...';
      const img = new Image();
      img.onload = function() {
        let width = img.width;
        let height = img.height;
        // resolution scaling
        if (currentResolution !== 'original') {
          const maxDim = parseInt(currentResolution, 10);
          if (width > height) {
            if (width > maxDim) { height = Math.round(height * (maxDim / width)); width = maxDim; }
          } else {
            if (height > maxDim) { width = Math.round(width * (maxDim / height)); height = maxDim; }
          }
        }

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.imageSmoothingEnabled = true;
        ctx.drawImage(img, 0, 0, width, height);

        // quality
        const qualityFactor = currentQuality / 100;
        let mimeType = 'image/jpeg';
        if (originalFile && originalFile.type === 'image/png') mimeType = 'image/png';
        else if (originalFile && originalFile.type === 'image/webp') mimeType = 'image/webp';
        // fallback to jpeg
        const compressed = canvas.toDataURL(mimeType, qualityFactor);

        // calculate size
        const byteString = atob(compressed.split(',')[1]);
        compressedSize = byteString.length;
        compressedDataURL = compressed;

        // update UI
        showPreview(compressed);
        const origKB = (originalSize/1024).toFixed(1);
        const compKB = (compressedSize/1024).toFixed(1);
        const ratio = ((1 - compressedSize/originalSize)*100).toFixed(1);
        statsDisplay.textContent = `Original: ${origKB} KB · Compressed: ${compKB} KB (${ratio}% smaller)`;
        statusMsg.textContent = `✅ Compression complete. ${ratio}% size reduction.`;

        // enable download
        downloadLink.style.display = 'block';
        downloadAnchor.href = compressed;
        // set filename
        const ext = mimeType.split('/')[1] === 'jpeg' ? 'jpg' : mimeType.split('/')[1];
        downloadAnchor.download = `compressed.${ext}`;
      };
      img.onerror = function() {
        statusMsg.textContent = '⚠️ Error decoding image.';
      };
      img.src = originalDataURL;
    }

    // events
    compressBtn.addEventListener('click', compressImage);

    downloadBtn.addEventListener('click', function() {
      if (compressedDataURL) {
        // trigger download via anchor
        downloadAnchor.click();
      } else {
        statusMsg.textContent = '⚠️ Compress the image first.';
      }
    });

    clearBtn.addEventListener('click', function() {
      originalFile = null;
      originalDataURL = null;
      compressedDataURL = null;
      originalSize = 0;
      compressedSize = 0;
      previewContainer.innerHTML = `<span style="color:#94a3b8;"><i class="fas fa-image"></i> No image loaded</span>`;
      downloadLink.style.display = 'none';
      statsDisplay.textContent = 'Original: — · Compressed: —';
      statusMsg.textContent = '🗑️ Cleared. Upload an image.';
    });

    // initial status
    statusMsg.textContent = '📂 Upload an image to compress.';
  })();
</script>

<!-- AdSense insertion point: replace placeholder with your AdSense unit code -->
</body>
</html>
